# Backend only. Use a file path or DEEPSEEK_API_KEY; never a VITE_ credential.
AGENT_MODE=deterministic
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Thinking is enabled by default. Set disabled only for an explicit opt-out.
DEEPSEEK_THINKING=enabled
DEEPSEEK_API_KEY_FILE=
PORT=4317
DATABASE_PATH=.runtime/chat.sqlite
